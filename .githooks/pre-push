#!/usr/bin/env sh
set -eu

echo "Validating macro layout..."
echo "Synchronizing character buffs compendium..."
node scripts/admin/sync-character-buffs.mjs
echo "Validating character buffs compendium..."
node scripts/admin/check-character-buffs.mjs
echo "Synchronizing spell compendium..."
node scripts/admin/sync-spell-cores-augments.mjs
echo "Validating spell compendium..."
node scripts/admin/check-spell-cores-augments.mjs
echo "Validating macro layout..."
node scripts/admin/check-macro-layout.mjs

if ! git diff --quiet -- \
  data/character-buffs \
  packs/character-buffs \
  scripts/admin/sync-character-buffs.mjs \
  scripts/admin/check-character-buffs.mjs \
  data/spell-cores-augments \
  packs/spell-cores-augments \
  scripts/admin/macro-compendium-config.mjs \
  scripts/admin/sync-spell-cores-augments.mjs \
  scripts/admin/check-spell-cores-augments.mjs \
  macros/player-macros \
  macros/gm-macros \
  macros/non-module \
  module.json \
  README.md \
  docs/module-setup.md \
  docs/release-checklist.md
then
  echo "Pre-push check stopped the push because compendium or macro pack changes are still unstaged or uncommitted."
  echo "Run npm run prepare:macro-packs, review the generated updates, and commit them before pushing."
  exit 1
fi

echo "Pre-push macro checks passed."
