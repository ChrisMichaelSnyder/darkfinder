#!/usr/bin/env sh
set -eu

echo "Validating macro layout..."
node scripts/admin/check-macro-layout.mjs

if ! git diff --quiet -- \
  scripts/admin/macro-compendium-config.mjs \
  macros/player-macros \
  macros/gm-macros \
  macros/non-module \
  module.json \
  README.md \
  docs/module-setup.md \
  docs/release-checklist.md
then
  echo "Pre-push check stopped the push because macro layout or pack configuration changes are still unstaged or uncommitted."
  echo "Run npm run sync:macro-compendiums, review the pack updates, and commit them before pushing."
  exit 1
fi

echo "Pre-push macro checks passed."
